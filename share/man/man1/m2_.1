.TP
\f[CR]\-p arg\f[R]
port, \f[CR]d_port=arg\f[R]
.TP
\f[CR]\-r arg\f[R]
reference, \f[CR]d_ref=arg\f[R]
.TP
\f[CR]\-m arg\f[R]
machine, \f[CR]d_machine=arg\f[R], default is HOSTNAME
.TP
\f[CR]\-c arg\f[R]
count, \f[CR]d_count=arg\f[R], default is \-1
.TP
\f[CR]\-s arg\f[R]
service, \f[CR]d_service=arg\f[R]
.TP
\f[CR]\-e arg\f[R]
executor, \f[CR]d_exec=arg\f[R]
.TP
\f[CR]\-V arg\f[R]
log\-deep, \f[CR]_M_GLOBAL_LOG_LVL=\[dq]${2:\-1}\[dq]\f[R]
.TP
