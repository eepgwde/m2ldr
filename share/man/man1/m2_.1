.TP
\f[CR]\-\-help\f[R]
as \f[CR]\-h\f[R]
.TP
\f[CR]\-\-dry\-run\f[R]
as \f[CR]\-n\f[R]
.TP
\f[CR]\-\-log\f[R]
as \f[CR]\-v\f[R]
.TP
\f[CR]\-\-log\-dest=arg\f[R]
as \f[CR]\-v\f[R] but with logging destination as \f[CR]arg\f[R]
.TP
