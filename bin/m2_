e_mod_lock '^e_'
e_mod_lock '^d_'

# logging is to stderr during boot-strapping
# Load the .def files which may define a logging destination of their own

# Source the .def files
for f in "${FOUND_DEF[@]}"; do
  e_fs_source0 "$f"
done

# Assess all the logging variables

# Now that _M__TRACE_ and getopt have both had their say,
# we finalize the state of the VERBOSE variable:
VERBOSE=$(e_is_logging)

# Post-processing for options -o and executable -e.
# runs here as another way to set _M__TRACE_
# These provide another way to set logging
[ -n "${d_options:-}" ] && d_evlr d_options
[ -n "${d_exec:-}" ] && d_evlr d_exec

# if a _M__TRACE_ variable exists use that to set switches

if [[ -n ${_M__TRACE_:-} ]]; then
  [[ "$_M__TRACE_" == *n* ]] && nodo="echo "
  [[ "$_M__TRACE_" == *x* ]] && xtrace="yes"
  [[ "$_M__TRACE_" == *p* ]] && nnunset="yes"

  # New 'v' flag logic: set to Level 1 (Stderr) if not already set
  if [[ $_M__TRACE_ == *v* ]]; then
    # If the value is empty/unset, set it to 1
    if [[ -z ${!log_lvl_v} ]]; then
      printf -v "$log_lvl_v" "1"
    fi
  fi

  # New 'l' flag logic: set to Level 2 (FIFO)
  if [[ $_M__TRACE_ == *l* ]]; then
    printf -v "$log_lvl_v" "2"
  fi
fi

_M_LOG_MODE="safe"
# In your flag processing logic
if [[ "$_M__TRACE_" == *!* ]]; then
  _M_LOG_MODE="perf"
  printf -v "$log_lvl_v" "2"
fi

## Logging
# All the different ways to configure logging have been loaded, so it can be started
# These use the indirect lookups - default is logging off
# and if logging is on, and nothing else specified it will use a pipe
# reset file descriptor 7 and set up the user's logging

if (( _M__LOG_ == 0 )); then
  exec 7>&-
  f_log_init "${!log_lvl_v:-0}" "${!log_dest_v}"
fi

# Finally source the log files - errors will go to log dest.
# Source the .sh files
for f in "${FOUND_SH[@]}"; do
  e_fs_source0 "$f"
done

# 6. Kickoff
# User scripts should have been loaded see VPATH
# errors here sometimes indicate a name clash - one of the user functions
# has clashed with one of the system's
f_main "$@"
exit $err_level
