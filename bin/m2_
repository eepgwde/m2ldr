#!/bin/bash

# This is the super-script. It provides a wrapper around other scripts.
# It is documented by a /usr/local/share/man/cat1 page.

# developer only - _M__TRACE_ in the environment
if [[ -n "${_M__TRACE_:-}" ]]; then
  [[ "$_M__TRACE_" == *d* ]] && set -x
fi

# set the default for site-wide trace to "-"
if [[ -z "${_M__TRACE_}" ]]; then
  _M__TRACE_="-"
fi

# for the module loader, the default is the current directory
if [[ -z "${_M__LOADR_}" ]]; then
  _M__LOADR_="."
fi

# Set of names for variables used by e_env and others
# These are mapped to getopts
readonly _M__VARS_=(dir file count password log user exec options output port ref aflag service)

# Others
# _M_GLOBAL_LOG_LVL
# _M_FIFO_OWNED="no"

# echo _M__TRACE_ $_M__TRACE_
# echo _M__LOADR_ $_M__LOADR_

## Recommendations:
# Function prefixes: d_ public command-line ; e_ public internal ; f_ protected internal
# Variables: d_ public command-line switches ; e_ public internal ; _M__<name>_ private internal
# Indirect variables: suffix _v

declare -r _M__VER_=1.2
declare -r _M__DESC_="script loading uses VPATHs, logging uses a file descriptor and forces set -u "

# if invoked with tracing
if [ "${SHELLOPTS}" != "${SHELLOPTS%%xtrace}" ]
then
  xtrace="yes"
fi

## initial logging to stderr
# --- PHASE 1: Bootstrap Logging ---
# Send everything to stderr so we catch syntax errors during load

## logging
# We may now be running new code that uses /dev/fd/7
# This function is defined here, because we want to change the logging to stderr
# if we have not inherited a definition of /dev/fd/7
f_log_state () {
  if [[ -e "$1" ]]; then
    local target=$(readlink "$1")
    local serr=$(readlink /dev/fd/2)
    local snull=$(readlink /dev/null)
    echo "$0: $1 : $target : fd2 : $serr" >&7
    # logging to stderr is fine
    [[ $target == $serr ]] && _M__LOG_=1
    # logging to null is no logging
    [[ $target == $snull ]] && _M__LOG_=2
    # logging to somewhere else
    _M__LOG_=3
  fi
}

# Later, only if _M__LOG_ is zero can we close the /dev/fd/7
typeset -i _M__LOG_=-1
# who set the logging if /dev/fd/7 has been set, then leave it as it is.
f_log_state /dev/fd/7
if (( _M__LOG_ < 0 )); then
  # we temporarily set it to stderr and mark ownership
  (( _M__LOG_=0 ))
  exec 7>&2
fi

f_cmd=""

## Operational mode
# Three types of script x__ x_ and x
# x__ system script /usr/local only; x_ user directory and /usr/local; x source directory only
# different VPATH for each

# We may have redirected the program to another using an exec call
# we can pass the original engine identity via an environment variable
# it is immediately unset to ensure it doesn't confuse forked programs
# The final implementation used is also recorded
declare -r d_interface=${_M__ENGN_ID0_:-${0##*/}}
[[ -v _M__ENGN_ID0_ ]] && unset _M__ENGN_ID0_
declare -r d_implementation="$(readlink -e $0)"

declare -r prog=${0##*/}
declare -r prog_args="$*"
# Don't use realpath for the $0, but for the directory it is in
declare -r prog_dir="$(realpath "$(dirname "$0")")"

## General Utilities for this script
#

## TODO For developers using nodo and logging
# Write to the logger not a target file if nodo is not empty.
# Add log device

## Add variables via options or exec or any string
# Expect a name of an environment variable which has a value like this
#   abc=def,ghi=jkl
#
d_evlr () {
  local var_name="$1"
  local raw_value="${!var_name}"
  [[ -z "$raw_value" ]] && return 0

  local IFS=","
  for pair in $raw_value; do
    # Extract key and value safely
    # ${pair%%=*} gets everything before the first '='
    # ${pair#*=}  gets everything after the first '='
    local key="${pair%%=*}"
    local val="${pair#*=}"

    # Validation: Ensure key is a valid variable name (alphanumeric/underscore)
    # and that an '=' actually existed in the pair
    if [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && [[ "$pair" == *"="* ]]; then
      # printf -v performs the assignment: key=val
      printf -v "$key" "%s" "$val"

      # Optional: If you want to see what happened during -x trace
      # [[ "${VERBOSE:-}" == "yes" ]] && echo "Option Set: $key='$val'" >&2
    fi
  done
}

# unused
e_nodo () {
  if [ -z "$nodo" ]; then
	  cat > "$1"
  else
	  cat
  fi
}

## Temporary files : remove temporary files on exit using f_tpush
# If no argument is given it will create a temporary file for you and return its path
# If the file is already in the list don't push it again.
# Was mis-named as f_tpush - that function is now a wrapper to this.

# This is now the base function, it uses name-refs
# It only manages TFILES as a set. It is annoyingly noisy
f_tpush0() { # $1 file being added to set
  # Case 2: Register an existing file (One argument)

  local -i restore_x=0

  # Check if 'x' is present in the current shell options ($-)
  if [[ $- == *x* ]]; then
    (( restore_x=1 ))
    set +x  # Turn it off
  fi

  local candidate="$1"
  # Hardlink check: Don't double-register the same inode
  for existing in "${TFILES[@]:-}"; do
    [[ -e "$candidate" && -e "$existing" && "$candidate" -ef "$existing" ]] && return 0
  done

  TFILES+=("$candidate")

  # restore trace
  if (( restore_x > 0 )); then
    set -x
  fi
}


## Get a temporary file or register files as temporary
# Legacy mode: if one or more arguments are given these are registered with TFILES.
# New mode: if no arguments given, echoes a temporary file to stdout
e_tpush() {
  # Case 1: Create and return a new file (No arguments) - legacy variant
  if [[ $# -eq 0 ]]; then
    local target
    target=$(mktemp)
    TFILES+=("$target")         # file is genuinely new so no need to use f_tpush0
    echo "$target"
    return 0
  fi

  local i
  for i in $@; do
    f_tpush0 "$1"
  done
}

# The Nameref Wrapper: Sets a variable to a new temp file path
e_tpush1() {
  if [[ $# -lt 1 ]]; then
    d_ERRMSG="[${FUNCNAME[0]}] Usage: $FUNCNAME <var_name>"
    return 1
  fi

  # Declare nameref to the variable name provided by the developer
  local -n __target_var="$1"

  local target
  target=$(mktemp)
  TFILES+=("$target")         # file is genuinely new so no need to use f_tpush0

  # Generate the file via the worker and assign it directly
  __target_var="$target"
}

# Legacy Compatibility
# ignore all but one command-line argument
f_tpush () {
  e_tpush "$1"
}

## No Unset
# These functions will be run at the end of the script and will be running under
# set -o nounset, so lots of precautions taking for undefined variables.

## Exiting from a function
# There is an err_level. The VERBOSE variable may be set and the developer is allowed to provide
# d_ERRMSG.

f_vpath_unique() {
  # Simplifies a VPATH before use.
  # Takes the NAME of the array variable as an argument
  local -n input_vpath=$1
  local -a unique_list=()
  declare -A seen_identities

  for dir in "${input_vpath[@]}"; do
    # 1. Skip null/empty strings immediately
    [[ -z "$dir" ]] && continue

    # 2. Early Exit: Check if directory exists AND is searchable (-x)
    # This prevents 'stat' from failing on permission-denied paths
    if [[ -d "$dir" && -x "$dir" ]]; then

      # 3. Get Physical Identity (Device ID : Inode)
      # -L follows symlinks to ensure we identify the REAL source
      # This handles bind mounts and symlinked config dirs perfectly.
      local identity
      identity=$(stat -L -c '%d:%i' "$dir" 2>/dev/null) || continue

      # 4. De-duplication check
      if [[ -z "${seen_identities[$identity]:-}" ]]; then
        unique_list+=("$dir")
        seen_identities["$identity"]=1
      fi
    fi
  done

  # 5. Overwrite the original array with the cleaned version
  input_vpath=("${unique_list[@]}")
}

## Special loader for JIT loading for the wrapper script
f_vpath_mldr () {
  local -n arg1_r=$1
  local -n arg2_r=$2
  local xsrc="$(readlink -e "$0")"
  # local xprog="${ }"

  local pth=""
  e_path_parse "$xsrc" "pth"
  # declare -p pth
  local base0="${pth[$_M_P_BASE]}"
  local dir0="${pth[$_M_P_DIR]}"
  local top0="$(realpath "$dir0/..")"

  # echo $xsrc
  # echo base0 : $base0
  # echo dir0 : $dir0
  # echo top0 : $top0

  local -a paths=(
    "$top0/etc"
    "$top0/share/site/cluster"
    "$top0/share/site/$machine_name"
  )

  arg1_r=("${paths[@]}")
  arg2_r="${base0}"

  return 0
}

## load locations
# This is important. Search for files .sh or .def that match prog.

f_vpath_files() {
  # Find the files on the VPATH
  # no need to check inodes in this version because the VPATH has been made unique
  local ext="$1"
  local nprog="${2:-${prog}}"
  local target_var="FOUND_${ext^^}"
  local -n current_vpath="${3:-$THIS_VPATH_NAME}"
  local -n list="$target_var"

  for dir in "${current_vpath[@]}"; do
    local candidate="$dir/$nprog.$ext"
    if [[ -s "$candidate" ]]; then
      # echo "# $FUNCNAME candidate = $candidate" >&7
      # safe works with inode safety
      # list+=("$(realpath "$candidate")")
      # easier to understand
      list+=("$candidate")
    fi
  done
}

# Wrapper calls
f_vpath_sh() {
  f_vpath_files "${FUNCNAME#f_vpath_}"
}
f_vpath_def() {
  f_vpath_files "${FUNCNAME#f_vpath_}"
}

# e_is_logging: Returns "yes" if any logging is enabled, else ""
e_is_logging() {
  local log_lvl_v="${prog}_logging_lvl"
  # Resolve the indirect variable. If > 0, we are verbose.
  if [[ ${!log_lvl_v:-0} -gt 0 ]]; then
    echo "yes"
  else
    echo ""
  fi
}

## main
# The Main Execution Gate
f_main() {
  local cmd="${d_cmd_default:-help}"
  local x_cmd=""
  local is_stateful="${d_stateful:-0}"

  # 0. Initial Resolve of command from $1
  if [[ $# -ge 1 ]]; then
    cmd="$1"; shift
  fi

  # 1. Identity Mapping
  if [[ -n "${d_helpflag:-}" ]]; then
    x_cmd="h_${cmd}"
  elif [[ "$is_stateful" -ne 0 ]]; then
    x_cmd="s_${cmd}"
  else
    x_cmd="d_${cmd}"
  fi

  # 2. Just-In-Time Resolution for the Target Command
  # If the function isn't in memory, try to load it from the .sh library
  if ! declare -F "$x_cmd" >/dev/null; then
    if ! d_resolve1 "$x_cmd"; then
      # d_resolve1 sets d_ERRMSG on failure
      return $?
    fi
  fi

  # 3. Stateful Engine Infrastructure Loading
  if [[ "$is_stateful" -ne 0 ]]; then
    # We look for the "Marker" function e_bus_load in the caller's base library
    local y_cmd="e_bus_load"
    local y_cmd_src=""

    if ! declare -F "$y_cmd" >/dev/null; then
      # We ask d_resolve1 to find the function in $CLLR_BASE and capture the file path
      if ! d_resolve1 "$y_cmd" "${CLLR_BASE:-}" "y_cmd_src"; then
        # d_resolve1 sets d_ERRMSG on failure
        return $?
      fi
    fi

    # Instead of running y_cmd, we source the file that contains it.
    # This populates e_bus_engine, e_bus_init, and the engine function itself.
    if [[ -f "$y_cmd_src" ]]; then
      source "$y_cmd_src"
    else
      # If it was already in memory, y_cmd_src might be empty.
      # We only source if d_resolve1 actually provided a path.
      # If it's already in memory, we assume infrastructure is present.
      :
    fi

    # Validation: Ensure the sourcing provided the name of the engine to run
    if [[ -z "${e_bus_engine:-}" ]]; then
      d_ERRMSG="[f_main] Failed to find state machine definition variable \"e_bus_engine\" after sourcing ($y_cmd_src)"
      return 4
    fi

    # Verify the specific s_ function was actually loaded (safety check)
    if ! declare -F "$x_cmd" >/dev/null; then
      d_ERRMSG="[f_main] Stateful function [$x_cmd] not found after resolution."
      return 8
    fi
  fi

  # --- 4. STRICT EXECUTION ZONE ---
  # Handle xtrace
  [[ ${xtrace:-} = yes ]] && set -x

  # Handle nounset (Negative logic: default is ON unless nnunset=yes)
  [[ ${nnunset:-no} != yes ]] && set -u

  f_cmd="${x_cmd}"

  # --- 5. LOGGING / STARTUP TRACE ---
  if { true >&7; } 2>/dev/null; then
    local ts
    ts=$(date +%FT%T.%3N)

    local e_user=$(id -un 2>/dev/null || echo "${USER:-unknown}")
    local e_host=$(hostname -s 2>/dev/null || echo "${HOSTNAME:-localhost}")
    local e_pwd="${PWD:-$(pwd)}"

    # Format: Time [PROG:CMD] (PID) Start: user@host:/current/path
    printf "%s [%s:%s] (%d) Start: %s@%s:%s\n" \
           "$ts" "$prog" "$f_cmd" "$$" "$e_user" "$e_host" "$e_pwd" >&7
  fi

  # --- 6. EXECUTION DISPATCH ---
  if [[ "$is_stateful" -ne 0 ]]; then
    # Run the engine defined in the sourced file, passing the user function
    "${e_bus_engine}" "$x_cmd" "$@"
  else
    # Standard direct dispatch for d_ or h_ functions
    ${x_cmd} "$@"
  fi

  local terr_level=$?
  err_level=$terr_level         # sync global err_level for the caller

  # Final Error Message Handling
  if [[ $terr_level -ne 0 && -z "${d_ERRMSG:-}" ]]; then
    d_ERRMSG="[${f_cmd}] terminated with non-zero exit code (${terr_level})"
  fi

  # Never return -1; it triggers the ERR trap and can cause races
  return $terr_level
}

## Close down
# Remove any temporary files
# Close down the logger
f_trap_exit() {
  local actual_exit=$?
  set +u

  # 1. Determine Final Status immediately
  local final_status=${err_level:-$actual_exit}
  [[ $final_status -eq 0 && $actual_exit -ne 0 ]] && final_status=$actual_exit

  # 2. LOG THE EXIT (While FD 7 is still open!)
  if { true >&7; } 2>/dev/null; then
    local ts=$(date +%FT%T.%3N)
    printf "%s [%s:%s] (%d) Exit: %d\n" "$ts" "$prog" "$f_cmd" "$$" "$final_status" >&7 || true
  fi

  # 3. REPORT ERROR (While FD 7 and FD 2 are still open!)
  # We use final_status here to decide if we speak
  if [[ $final_status -ne 0 ]]; then
    # Synchronize err_level so f_err_msg knows the score
    err_level=$final_status
    f_err_msg
  fi

  # Clear temporary files - if verbose leave them for analysis
  if [[ "${VERBOSE:-no}" != "yes" ]]; then
    rm -f "${TFILES[@]:-}" 2>/dev/null
  else
    # echo "# $prog $FUNCNAME : TFILES : ${TFILES[@]}" >&7
    true
  fi

  # NOW CLOSE LOGGING
  if (( _M__LOG_ == 0 )); then
    exec 7>&- 2>/dev/null

    if [[ "${_M_FIFO_OWNED:-no}" == "yes" ]]; then
      sleep 0.1
      if [[ -p "${!log_dest_v:-}" ]]; then
        rm -f "${!log_dest_v}" 2>/dev/null
      fi
    fi
  fi

  # allow to be called without exit
  if [[ -z "$_M__NEXIT_:-" ]]; then
    exit "$final_status"
  fi
}

## Errors, assert and error trap module
# set -u compliant

f_err_msg() {
  # If d_ERRMSG is empty, provide a basic fallback
  if [[ -z "${d_ERRMSG:-}" ]]; then
    d_ERRMSG="[${prog}] Unknown failure in ${f_cmd} (Status: ${err_level})"
  fi

  # 1. Force to the Log File (FD 7)
  if { true >&7; } 2>/dev/null; then
    echo "$msg" >&7
  fi

  if [ -z "${d_quiet:-}" ]
  then
  # Print the whole block (Error + Appended Stack) to stderr
  {
    echo -e "\n\033[1;31m!!! ERROR REPORT !!!\033[0m"
    echo "$d_ERRMSG";
    echo -e "\033[1;31m!!!!!!!!!!!!!!!!!!!!\033[0m\n";
  } >&2
  fi

  # Clear it so it doesn't double-print if traps overlap
  d_ERRMSG=""
}

f_trap_err() {
  # Capture the specific exit code of the failed command
  local failed_code=$?
  # Capture the line number where it happened
  local line_no=$1

  # Update the global error level so f_trap_exit knows we crashed
  err_level=$failed_code

  # Optional: Provide a debug message to stderr if VERBOSE is on
  if [[ "${VERBOSE:-no}" == "yes" ]]; then
    {
      echo "${prog}: DEBUG: Command failed at line $line_no with status $failed_code";
      e_cstack0;
    } >&2
  fi

  # f_trap_exit would be triggered automatically after this function returns
  # if the script exits, but call it now
  f_trap_exit
}

## Call stack
# This places the call stack into the d_ERRMSG variable
e_cstack0() {
  # Ensure d_ERRMSG exists to avoid nounset crashes
  : "${d_ERRMSG:=}"

  d_ERRMSG+=$'\n'"Stack Trace:"

  local i
  # We use the length of FUNCNAME to bound the loop
  local stack_depth=${#FUNCNAME[@]}

  for ((i=1; i<stack_depth; i++)); do
    # Safely extract values with defaults for nounset stability
    local func="${FUNCNAME[$i]:-unknown}"
    local src="${BASH_SOURCE[$i]:-unknown}"

    # Calculate the calling line index safely
    local line_idx=$((i - 1))
    local line="${BASH_LINENO[$line_idx]:-?}"

    d_ERRMSG+=$'\n'
    d_ERRMSG+="  -> ${func}() at ${src}:${line}"
  done

  # Log to >&7 so the developer sees the trace in the log file too
  echo "$d_ERRMSG" >&7

  return 0
}

# e_err_report0 (reason)
# Internal helper to format the global error message and capture the stack.
e_err_report0() {
  local __reason="${1:-Unknown Error}"

  # Initialize/Reset the global error message
  d_ERRMSG="ERROR: ${__reason}"

  # Append the stack trace using your existing logic
  e_cstack0
}

# e_err_fatal0 (reason)
# Reports the error and exits.
e_err_fatal0() {
  e_err_report0 "$1"
  echo "$d_ERRMSG" >&2
  exit 2
}

# user assert operation
e_assert0 () {
  if [[ $? != 0 ]]
  then
    d_ERRMSG="Assertion failed at line: ${1:-0}"
    d_ERRMSG+=$'\n'  # Adds a newline
    d_ERRMSG+="Stack Trace:"

    e_cstack0

    exit 2
  fi
}

## Pointer Operations

## cycle back through the pointers
# We create local -n __shadow="m_stk1". This forces Bash to link __shadow to the
# m_stk1 in your caller's scope. When we then ask for ${!__shadow}, Bash looks
# at the target of that link (_example2_stk1) and returns that name.
e_ptr_resolve() {
  local -n __ret_ptr=$1
  local __current_name="$2"

  while true; do
    # 1. Check if the name exists and what it is
    local __decl
    __decl=$(declare -p "$__current_name" 2>/dev/null) || break

    # 2. If it's NOT a nameref, we've reached the end of the trail
    [[ "$__decl" == "declare -n"* ]] || break

    # 3. If it IS a nameref, we must resolve it.
    # We bind a temporary nameref to the current name.
    # This "reaches back" to the caller's scope.
    local -n __shadow="$__current_name"
    __current_name="${!__shadow}"
  done

  __ret_ptr="$__current_name"
}

## Stack operations
# ==============================================================================
# MODULE: stk (Generic Stack Operations using a sentinel)
# STACK OPERATIONS (Sentinel-based)
# ==============================================================================


# These are a bit odd. They have a null empty - an empty at the 1st position
# The pointer to the stack has to be resolved to test if it is genuinely an array.

# is a stack empty, return 0 if so else 1
# no sentinel for this
e_stk_empty0() {
  local __target_name=""
  e_ptr_resolve __target_name "$1"

  local -n __s_ref="$__target_name"

  # Length 1 with empty element check
  [[ ${#__s_ref[@]} -le 1 ]] && return 0
  return 1
}

# e_stk_push0 (stack_ptr, value, sentinel)
# Pushes a value. Validates that the value is NOT the sentinel.

e_stk_push0() {
  local __target_name=""
  e_ptr_resolve __target_name "$1"
  local __val="$2"

  # Guard 1: Argument count
  [[ $# -lt 3 ]] && e_err_fatal0 "$FUNCNAME (ptr: $1): Missing mandatory sentinel"

  local __sentinel="$3"

  # Guard 2: Sentinel Violation
  [[ "$__val" == "$__sentinel" ]] && \
    e_err_fatal0 "$FUNCNAME (ptr: $1): Cannot push value equal to sentinel [$__sentinel]"

  # --- Logic ---
  if [[ "$(declare -p "$__target_name" 2>/dev/null)" != "declare -a"* ]]; then
    declare -ag "$__target_name"
    local -n __s_ref="$__target_name"
    __s_ref=('')
  fi

  local -n __s_ref="$__target_name"
  __s_ref+=("$__val")
}

e_stk_pop0() {
  local __target_name=""
  e_ptr_resolve __target_name "$1"
  local -n __dest_var="$2"

  # Guard: Mandatory Sentinel
  [[ $# -lt 3 ]] && e_err_fatal0 "$FUNCNAME (ptr: $1): Missing mandatory sentinel"
  local __sentinel="$3"

  local -n __s_ref="$__target_name"
  if [[ ${#__s_ref[@]} -le 1 ]]; then
    __dest_var="$__sentinel"
    return 1
  fi

  local __last_idx=$(( ${#__s_ref[@]} - 1 ))
  __dest_var="${__s_ref[$__last_idx]}"
  unset "__s_ref[$__last_idx]"
}

# e_stk_peek0 (stack_ptr, dest_var, sentinel)
# Copies top value into dest_var without unsetting.

# e_stk_peek0 (stack_ptr, dest_var, sentinel)
# Copies top value into dest_var without unsetting.
# Fatal error if sentinel is missing. Returns 1 if stack is empty.
e_stk_peek0() {
  local __target_name=""
  e_ptr_resolve __target_name "$1"
  local -n __dest_var="$2"

  # Guard: Mandatory Sentinel (Arity check)
  [[ $# -lt 3 ]] && e_err_fatal0 "$FUNCNAME (ptr: $1): Missing mandatory sentinel"
  local __sentinel="$3"

  local -n __s_ref="$__target_name"

  # Boundary: Check if stack is empty (only has the framework floor)
  if [[ ${#__s_ref[@]} -le 1 ]]; then
    __dest_var="$__sentinel"
    return 1
  fi

  # Assignment: Look at the top without unsetting
  __dest_var="${__s_ref[$(( ${#__s_ref[@]} - 1 ))]}"
  return 0
}

# e_stk_show0 (stack_ptr, [sentinel_label])
# Debug trace of the stack sent to FD 7.
e_stk_show0() {
  local __target_name=""
  e_ptr_resolve __target_name "$1"
  local __label="${2:-SENTINEL}"

  local -n __s_ref="$__target_name"
  local __len=${#__s_ref[@]}

  {
    echo "--- $FUNCNAME : stack trace: $1 ($__target_name) ---"
    if [[ $__len -eq 0 ]]; then
      echo "  [UNINITIALIZED]"
    else
      for (( i=__len-1; i>=0; i-- )); do
        [[ $i -eq 0 ]] && printf "  [%2d]: %s (%s)\n" "$i" "${__s_ref[$i]}" "$__label" || \
            printf "  [%2d]: %s\n" "$i" "${__s_ref[$i]}"
      done
    fi
    echo "-----------------------"
  } >&7
}

# Registration
# Note: $LINENO is passed so you know exactly where the script tripped
trap 'f_trap_err $LINENO' ERR

## Logging & Cleanup Module
# not set -u compliant

# Global State Initialization for logging

# Helper to generate the path that matches the systemd socket unit
# see m_.org
# Reconciles with systemd %t/%i-trace-fifo unit.
# We log to the name given if that is not defined to the prog
# But we now over-ride using d_implementation. This latter arrangement means
# all wrappers log to the same FIFO
# If d_implementation is defined we log to that.
# uses a name-ref

f_log_path () {
  local -r type0="$1"
  local -n rval="${2}"

  # path may already be a socket or a fifo
  case $type0 in
    fifo)
      [[ -p "$rval" ]] && return 0
      ;;
    sock)
      [[ -S "$rval" ]] && return 0
      ;;
  esac

  local base_name=""
  if [[ -n "${3:-}" ]]; then
    base_name="$3"
  elif [[ -n "$d_implementation" ]]; then
    base_name=${d_implementation##*/}
  else
    base_name="$prog"           # must be a global here.
  fi

  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    # Path used by trace-fifo@.socket
    rval="$XDG_RUNTIME_DIR/${base_name}-trace-${type0}"
  else
    # Standard Fallback
    rval="/tmp/${base_name}-${type0}-${UID:-0}"
  fi
}

f_log_init() {
  local lvl=${_M_GLOBAL_LOG_LVL:-$1}
  # If the user already set --log-dest, use it; otherwise, use the helper

  local dest=""
  local -a p_dest=('')

  # use the global override
  if [[ -v _M_GLOBAL_LOG_LVL ]]; then
    if [[ "$_M_GLOBAL_LOG_LVL" > 0 ]]; then
      if [[ -v _M_GLOBAL_LOG_DST ]]; then
        dest="$_M_GLOBAL_LOG_DST"
      fi
    fi
  fi

  if [[ -n "${2:-}" ]]; then
    dest="${2}"
  fi

  # For tcp, we re-use dest.
  e_path_parse "${dest}" p_dest
  local dest0="$dest"

  if [[ "${p_dest[2]}" == tcp ]] || [[ "${p_dest[2]}" == tcp6 ]]  || [[ "${p_dest[2]}" == mcast ]] ; then
    d_ERRMSG="$prog $FUNCNAME invalid URL $dest : tcp://hostname:port tcp6://hostname:port mcast://hostname:port (port is an integer 1024 to 65535)"
    [[ -n "${p_dest[5]}" ]] || { exit 1; }
    # Get the port from your info array
    local -i port0="${p_dest[5]}"
    local pattern="^[0-9]+$"
    [[ "$port0" =~ $pattern ]] || { exit 1; }

    # Optional: Check if it's within the valid range (1-65535)
    (( port0 > 1024 )) && (( port0 <= 65535 )) || { exit 1; }
    d_ERRMSG=""

    dest="${p_dest[2]}"
  fi

  if [[ -z "$dest" ]]; then
    f_log_path sock "dest"
  elif [[ $dest == *"fifo" ]]; then
    f_log_path fifo "dest"
  elif [[ $dest == *"sock" ]]; then
    f_log_path sock "dest"
  fi

  local final_dest=""
  _M_FIFO_OWNED="no"

  while true; do
    if { true >&7; } 2>/dev/null; then break; fi # Inherit
    if [[ $lvl -le 0 ]]; then final_dest="/dev/null"; break; fi
    if [[ $lvl -eq 1 ]]; then final_dest="stderr"; break; fi

    if [[ "$dest" == tcp ]] || [[ "$dest" == tcp6 ]] || [[ "$dest" == mcast ]] ; then
      final_dest=$dest
      break
    fi

    local ts=$(date +%FT%T.%3N)

    # now use a realpath
    dest="$(realpath "$dest")"

    if [[ $dest == *"fifo"* ]] || [[ -p $dest ]]; then
      if [[ ! -p $dest ]]; then
        mkdir -p "${dest%/*}" 2>/dev/null
        mkfifo -m 600 "$dest" 2>/dev/null && _M_FIFO_OWNED="yes"
      fi
      [[ -w $dest ]] && {
        final_dest=$dest ;
        printf "%s [%s:%s] (%d) Choosing FIFO: %s\n" \
               "$ts" "$prog" "$FUNCNAME" "$$" "$final_dest" >&2 ;
        break;
      }
    else
      mkdir -p "${dest%/*}" 2>/dev/null
      touch "$dest" 2>/dev/null
      [[ -w $dest ]] && {
        final_dest=$dest;
        printf "%s [%s:%s] (%d) Choosing other: %s\n" \
               "$ts" "$prog" "$FUNCNAME" "$$" "$final_dest" >&2
        break;
      }
    fi

    final_dest="stderr"
    break
  done

  # echo "# $0 $FUNCNAME final_dest \"$final_dest\"" >&2
  case "$final_dest" in
    # "")          return 0 ;; # disabled Inheritance, I think
    ""|"/dev/null") exec 7> /dev/null ;; # Inherited systems might use /dev/null
    "stderr")    exec 7>&2 ;;
    *fifo)
      if [[ -p $final_dest ]]; then
        if [[ "$_M_LOG_MODE" == perf ]]; then
          # PERF: No timeout. Low latency no pipe overrun. Slower
          # Script will pause (backpressure) if buffer is full.
          exec 7> >(cat > "$final_dest" 2>/dev/null || true)
        else
          # SAFE: 0.1s timeout. Higher latency possible pipe overrun.
          # Protects against hangs but fails under high stress.
          exec 7> >(timeout 0.5 cat > "$final_dest" 2>/dev/null || true)
        fi
        printf "%s [%s:%s] (%d) Logging to FIFO: %s\n" \
               "$ts" "$prog" "$FUNCNAME" "$$" "$final_dest" >&2
      fi
      ;;

    *sock)
      if [[ -S $final_dest ]]; then
        exec 7> >(socat -u STDIN UNIX-CONNECT:$final_dest)
        printf "%s [%s:%s] (%d) Logging to socket: %s\n" \
               "$ts" "$prog" "$FUNCNAME" "$$" "$final_dest" >&7
      fi
      ;;
    mcast|tcp6|tcp)
      local proto="tcp"
      local e_exec0=""
      local facility=16  # local1

      case "$final_dest" in
        tcp)
          facility=17  # local1
          e_exec0="socat -T 2 -u - TCP4:${p_dest[0]}:${p_dest[5]},retry=3,interval=0.2 2>/dev/null"
          ;;
        tcp6)
          facility=17  # local1
          e_exec0="socat -T 2 -u - TCP6:${p_dest[0]}:${p_dest[5]},retry=3,interval=0.2 2>/dev/null"
          ;;
        mcast)
          e_exec0="socat -u - UDP4-DATAGRAM:${p_dest[0]}:${p_dest[5]},ip-multicast-ttl=1 2>/dev/null"
          proto="udp"
          ;;
      esac

      # 2. Strip brackets from IP address if present (e.g., "[fd62:...]" -> "fd62:...")
      local clean_addr="${p_dest[0]//[\[\]]/}"

      # for the d_alert function
      # 3. Declare e_alert_args globally (-g) as an associative array (-A)
      declare -gA e_alert_args=(
        ['proto']="$proto"
        ['facility']="$facility"
        ['addr']="$clean_addr"
        ['port']="${p_dest[5]}"
      )

      local severity=7  # Debug
      local pri=$(( (facility * 8) + severity ))
      local host="${HOSTNAME}.6site0" # Domain-name host identifier

      # Open FD 7 wrapped in a resilient subshell loop
      exec 7> >(
        # Ignore SIGPIPE inside the collector subshell so it doesn't crash on write failure
        trap '' PIPE

        while IFS='' read -r line || [[ -n "$line" ]]; do
          if [[ "$line" =~ ^\<([0-9]{1,3})\>(.*)$ ]]; then
            line_pri="${BASH_REMATCH[1]}"
            msg="${BASH_REMATCH[2]}"
          else
            line_pri="$pri"
            msg="$line"
          fi

          ts="$(date +"%Y-%m-%dT%H:%M:%S.%3N")"

          # Use a non-fatal printf; if socat closes, pipe errors are suppressed
          printf "<%d>%s %s %s[%d]: %s\n" \
                 "$line_pri" "$ts" "$host" "$prog" "$$" "$msg" 2>/dev/null || true

        done | { eval "$e_exec0" || true; }
      )

      # Immediate announcement header burst sent straight out to the multicast channel
      printf "Tracing via $final_dest ${p_dest[0]} ${p_dest[5]}\n" >&7
      final_dest=$dest0
      ;;

    *)
      exec 7>> "$final_dest"
      printf "%s [%s:%s] (%d) Logging to other: %s\n" \
             "$ts" "$prog" "$FUNCNAME" "$$" "$final_dest" >&7
      ;;
  esac

  if [[ "$lvl" -ge 2 ]]; then
    export _M_GLOBAL_LOG_DST="$final_dest"
  fi
}

# Ensure the trap is set immediately
trap f_trap_exit EXIT SIGINT SIGTERM

## SIGPIPE trap
# Only needed for fifo, we now prefer to use a socket.
# If ignored, sub-shells will error with cannot write to pipe
# May cause issues with later use and require a reset
#
# actively reset - might work
# trap 'f_log_init "${!log_lvl_v:-0}" "${!log_dest_v}"' SIGPIPE
#
# ignore
trap '' SIGPIPE

