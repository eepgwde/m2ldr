: ${d_file:=""}
: ${d_service:=""}

## Resets
# Our caller may have set these - for subscripts we turn them off
nodo=""                         #  either "" or echo - prefixes a command to allow a non-destructive run

# f_log_init redirects something to /dev/fd/7
declare -r verbose=/dev/fd/7
# Old way is this and is slower, it opens and closes
#  echo filename is myfile > $verbose
# New way is this and faster, it uses a buffer
#  echo filename is myfile >&7

# Indirect
# Used extensively - the logging settings are spcific to $prog so we hold them in these variables
log_lvl_v="${prog}_logging_lvl"
log_dest_v="${prog}_logging_dest"

# Store all the arguments
d_args="$*"

## Options
# we now use util-linux getopt that supports long options

# 1. Define the options strings
# Short options: 'o:' means -o takes an argument. 'v' means -v does not.
declare -r SHORT_OPTS="O:P:ahqnvxd:f:o:l:u:p:r:m:c:s:e:V:"
# Long options: 'log-dst:' means --log-dst takes an argument. 'log' means --log does not.
declare -r LONG_OPTS="verbose,quiet,help,dry-run,log,log-dest:,log-deep:,orchestrate:,stateful"

# 2. Use getopt to parse and "normalize" the arguments
# The -- "$@" handles spaces in filenames correctly.
declare -r PARSED_OPTS=$(getopt -o "$SHORT_OPTS" --long "$LONG_OPTS" -n "$prog" -- "$@")
if [ $? -ne 0 ]; then
  Usage 2 "Invalid switch specified - abort."
fi

# 3. Replace the current positional parameters ($1, $2, etc.) with the parsed ones
eval set -- "$PARSED_OPTS"

# 4. Process options in a while loop
while true; do
  case "$1" in
    -h|--help)
      d_helpflag="yes"; shift ;;
    -x)
      xtrace="yes"; shift ;;
    -q|--quiet)
      d_quiet="yes"; VERBOSE="";
      # could be, but default to f_log_init
      # printf -v "${prog}_logging_lvl" "0"
      shift ;;
    -a|--alternative)
      d_aflag="yes"; shift ;;
    -n|--dry-run)
      nodo="echo "; shift ;;

    # New Long Options examples
    -v|--verbose)
      d_quiet=""
      # Level 1 signals "Standard Error"
      printf -v "${prog}_logging_lvl" "1"
      shift ;;
    --log)
      d_quiet=""
      # Level 2 signals "FIFO/File"
      printf -v "${prog}_logging_lvl" "2"
      shift ;;
    --log-dest)
      d_quiet=""
      printf -v "${prog}_logging_dest" "%s" "$2"
      # If they provide a destination, we assume they want FIFO/File logic
      printf -v "${prog}_logging_lvl" "2"
      shift 2 ;;

    --orchestrate)
      d_orchestrate="$2"; shift 2 ;;

    --stateful)
      d_stateful=1; shift ;;

    -V|--log-deep)
      # Level-based deep logging - child processes will inherit this and log as well.
      export _M_GLOBAL_LOG_LVL="${2:-1}"
      shift 2 ;;

    # Existing short options
    -o) d_options="$2"; shift 2 ;;
    -r) d_ref="$2"; shift 2 ;;
    -l) d_log="$2"; shift 2 ;;
    -d) d_dir="$2"; shift 2 ;;
    -f) d_file="$2"; shift 2 ;;
    -s) d_service="$2"; shift 2 ;;
    -u) d_user="$2"; shift 2 ;;
    -p) d_port="$2"; shift 2 ;;
    -P) d_password="$2"; shift 2 ;;
    -c) d_count=$2; shift 2 ;;
    -m) d_machine="$2"; shift 2 ;;
    -O) d_output="$2"; shift 2 ;;
    -e) d_exec="$2"; shift 2 ;;

    --) # End of options
      shift; break ;;
    *)
      Usage 2 "Internal error during parsing." ;;
  esac
done


# No more 'expr $OPTIND - 1' needed!
# 'eval set -- "$PARSED_OPTS"' and the 'shift' logic inside the loop
# already cleaned up the arguments. Now $1 is your command/function name.

## Function library and definition files
# Define the Search Paths - The VPATHs

# the machine the script is running on - d_machine is for the developer/user
: ${machine_name:=$(hostname -s)}

# Set the path from the source link of $0
CLLR_VPATH=""
CLLR_BASE=""
f_vpath_mldr CLLR_VPATH CLLR_BASE

# System: Wide to Narrow : vendor - site -
SYS_VPATH=(
  "/usr/local/etc"
  "/usr/local/share/site/cluster"
  "/usr/local/share/site/$machine_name"
)

# User: System paths + Home overrides - these use a user-specified machine
# by d_machine or the default. When it is user-specified it can be in the environment.
USER_VPATH=(
  "${SYS_VPATH[@]}"
  "$HOME/etc"
  "$HOME/share/site/cluster"
  "$HOME/share/site/${d_machine:-${machine_name}}"
)

# App: Local directory + Machine sub-dir
# this one uses the user's choice of machine.
# d_service may be empty so and d_user avoid a duplicate
# Other directories may be protected
APP_VPATH=(
  "$prog_dir"
  "$prog_dir/$d_user"
  "$prog_dir/$d_service"
  "$prog_dir/$d_machine"
)

# simplify the paths
f_vpath_unique CLLR_VPATH
f_vpath_unique SYS_VPATH
f_vpath_unique USER_VPATH
f_vpath_unique APP_VPATH

# --- Logic to select the active VPATH name ---
if [[ "$prog" == *__ ]]; then
  THIS_VPATH_NAME="SYS_VPATH"
elif [[ "$prog" == *_ ]]; then
  THIS_VPATH_NAME="USER_VPATH"
else
  THIS_VPATH_NAME="APP_VPATH"
fi

