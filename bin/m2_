## An alert method
# writes to the syslog-trace

f_alert_args() {
  local status_msg

  # Check if e_alert_args is set and declared as an associative array
  if [[ $(declare -p e_alert_args 2>/dev/null) =~ "declare -A" ]]; then
    cat <<EOF
Status: DEFINED

Configuration Details:
  - Protocol (proto)   : ${e_alert_args['proto']}
  - Facility (facility): ${e_alert_args['facility']}
  - Target Addr (addr) : ${e_alert_args['addr']}
  - Target Port (port) : ${e_alert_args['port']}"
EOF
  else
    echo "Status: UNDEFINED"
  fi
}

h_alert () {
  cat >&2 <<EOF
 $prog ${FUNCNAME##h_} level message-string

0   emerg (panic)
1   alert
2   crit
3   err (error)
4   warning (warn)
5   notice
6   info
7   debug

Another method to change the facility and level is to use >&7 but with a prefix to the message: <PRI> where PRI is
 (facility * 8) + level

  printf "<130> [%s] level\n" "$FUNCNAME" >&7

facility is a number

16  local0, 17 local1 and so on.

130 is local0.crit, 138 is local1.crit

EOF

  f_alert_args 2>&1
}

d_alert() {
  # 1. Return silently if e_alert_args is undefined or not an associative array
  [[ $(declare -p e_alert_args 2>/dev/null) =~ declare\ -[a-zA-Z]*A ]] || return 0

  local sev="$1"
  shift

  # Fallback to severity 2 (crit) if $1 is missing or not a single digit 0-7
  if [[ ! "$sev" =~ ^[0-7]$ ]]; then
    sev=2
  fi

  # Extract facility from e_alert_args array
  local fac="${e_alert_args['facility']}"

  # Calculate numerical PRI dynamically: (facility * 8) + severity
  local pri_val=$(( (fac * 8) + sev ))

  # Get caller's function name:
  # FUNCNAME[0] = d_alert
  # FUNCNAME[1] = function that called d_alert
  local caller_func="${FUNCNAME[1]:-main}"

  # Write directly to FD 7 with the <PRI> prefix and calling function name
  printf "<%d>[%s] %s\n" "$pri_val" "$caller_func" "$*" >&7
}

d_alert_log () {
  test $# -ge 1 || return 2
  local e_cmd="$1"
  shift
  (( d_count > 0 )) || (( d_count=130 ))
  : ${d_service:=1}

  case $e_cmd in
	  priority)
      echo "<${d_count}> local0.crit" >& 7
      ;;
	  alert)
      d_alert $d_service severity ${d_service} alert
      ;;
    *)
      echo "default message" >& 7
      ;;
  esac
}

## Script status
# How the script has been initialized

h_this0 () {
  cat >&2 <<EOF
 $prog [-a] ${FUNCNAME##h_} command

Program: \$0 : $0 ; readlink: $(readlink $0); realpath:$(realpath $0)

Commands are grouped to help explain them

 Group        : Commands

 support files: support|support-def|support-value
 directory    : user|share|user0|script
 functions    : loaded|hloaded|loaded-all
 identity+    : identity|settings
 developer    : mloader|vpath|version|test-alert|test-logging

- Support files:

 support    : locations of library scripts .sh
 support-def : locations of definitions .def
 support-value : contents of the .def files

Links are unresolved. Listed in loaded order.
Definitions in a later file override those in from a file before.

support-def contains two system files.

support-value shows the _M variables that control trace and logging.

- Directory

  script: the directory from which the loader script was run
  user0: the first directory for library support script
  user|share: the last directory

- Functions

These two can take the -a switch which shows the internal name and the
internal functions, prefixed with e_

  loaded: all the functions that have been loaded
  hloaded: all the help functions

  loaded-all: all the functions, including system, prefixed with f_

- Identity+

  identity: identity and paths of the script and its loader/executor
  settings: the option arguments and internal variable names

- Developer 

  mloader: paths used to find script library and definitions
  vpaths: paths available for the mloader
  version: current version
  test-alert|test-logging: tests d_alert and >&7 logging

Useful for script debugging, show the support files $prog .sh and .def file contents
'support' lists all the files .sh and .def - size must be greater than zero
'support-def' catenates the contents of just the .def files

EOF
}


d_this0 () {
  test $# -ge 1 || return 2
  local e_cmd="$1"
  shift

  case $e_cmd in
	  support-value)
	    echo ${FOUND_DEF[*]} | xargs -n1 | egrep '\.def$' | while read i
	    do
		    printf "\043 %s\n" "$i"
        cat "$i"
      done | sed -n '/[^[:space:]]/p'

      echo '# script local'
      set | grep -E '^(_M_)'
	    ;;

	  # xargs is limited on cygwin
	  support-def)
      printf "%s\n" "${FOUND_DEF[@]}"
	    ;;

    test-alert)
      d_alert 2 alert is two
      ;;
    test-logging)
      printf "<138> [%s] level\n" "$FUNCNAME:$e_cmd" >&7
      ;;

	  support)
      printf "%s\n" "${FOUND_SH[@]}"
      # cygwin
	    # echo ${FOUND_SH[*]} | env -i PATH="$PATH" /usr/bin/xargs -n1
	    ;;

	  cygwin)
		  set
		  xargs --show-limits
	    # echo ${D_SUP0[*]} |
	    ;;

    resolve)
      # locate a file via readlink
      local x0
      : ${x0:="$1"}
      : ${x0:="$0"}

      cd "$(dirname "$(readlink -f "$x0")")"; echo $PWD
      ;;

	  sources)
      ## this finds the sourced scripts
      # it is set to locate the most derived script - the user's own.
      : ${d_service:='.sh'}
      local e_place="$"
      if [ $d_count -gt 0 ]
      then
        let e_place=$d_count
      fi
      d_this0 support | egrep "${d_service}$" | sed -n "${e_place}p"| ( read d_file; $FUNCNAME resolve $d_file )
      ;;

    script)
      ## this locates the top-level wrapper script.
      $FUNCNAME resolve $0
	    ;;

    user0)
	    local x0=$($FUNCNAME support | sed -n '1p')
	    dirname $(readlink -f $x0)
	    ;;

    user|share)
	    local x0=$($FUNCNAME support | sed -n '$p')
	    dirname $(readlink -f $x0)
      ;;

    loaded)
      : ${x_cols:=$COLUMNS}
      : ${x_cols:=80}
      typeset -i n_cols=${x_cols}-10

      if [ -z "${d_aflag:-}" ]; then
        compgen -A function d_ | sed -E -e 's/^d_//g' | xargs | fold -s --width="$n_cols"
      else
        { compgen -A function d_; compgen -A function e_;  } | xargs | fold -s --width="$n_cols"
      fi 1>&2
      ;;

    hloaded)
      : ${x_cols:=$COLUMNS}
      : ${x_cols:=80}
      typeset -i n_cols=${x_cols}-10

      if [ -z "${d_aflag:-}" ]; then
        compgen -A function h_ | sed -E -e 's/^h_//g' | xargs | fold -s --width="$n_cols"
      else
        { compgen -A function h_; compgen -A function e_;  } | xargs | fold -s --width="$n_cols"
      fi 1>&2
      ;;

    loaded-all)
      declare -F
      ;;

    mloader)
      declare -p CLLR_VPATH
      declare -p CLLR_BASE
      ;;

    vpath|vpaths)
      declare -p SYS_VPATH USER_VPATH APP_VPATH CLLR_VPATH THIS_VPATH_NAME
      ;;

    settings)
      d_settings0 $*
      ;;

    identity)
      # The program may not be running under its true name.
      # For example, toor_ has been redirected to toor__ using /usr/local/linux-gnu/m_x
      echo prog=$prog
      echo prog_dir=$prog_dir
      echo d_interface=${d_interface:-}
      echo d_implementation=${d_implementation:-}
      echo "# \$0=$0"
      ;;

    version)
      printf "Version: %s ; Description: %s ; Location: %s" "$_M__VER_" "$_M__DESC_" "$0"
      ;;

    *)
      echo "Usage: ${FUNCNAME##d_} -h or support|support-def|support-value|support-loaded" 1>&2
      return 1
      ;;
  esac
  return 0
}

d_recurse0 () {
  # called directly my_pid is none
  # called by recurse1 my_pid is PID:d_recurse1 == PID:d_recurse0
  # called by recurse2 my_pid is PID:d_recurse2 == PID:d_recurse0 but $1 is "invoked"
  # called by recurse3 my_pid is PID:d_recurse3 == PID:d_recurse0 but $1 is "invoked"
  # called by recurse4 my_pid is PID:d_recurse4 != PID:d_recurse0 but $1 is "invoked"
  echo "$FUNCNAME invoked as PID ($$) from PID ($1) : my_pid : ${my_pid:-none}"
  [[ "$$" == "$1" ]] && echo "local"
  [[ "$1" == "invoked" ]] && echo "invoked"
  [[ "$1" != "invoked" ]] && [[ "$$" != "$1" ]] && echo "forked"
  my_pid+=" - ${my_pid:-none}"
  return 0
}

d_recurse1 () {
  local my_pid="pid-$$"
  echo "$FUNCNAME invoking recurse0 locally from PID ($$) from PID ($1)"
  d_recurse0 $$
  echo "$FUNCNAME invoked recurse0 locally and my-pid is now \"${my_pid}\""
  return $?
}

d_recurse2 () {
  # weird: recurse0 receives the word "invoked" as $$
  local my_pid="pid-$$"
  echo "$FUNCNAME invoking recurse0 function sub-shell from PID ($$) from PID ($1)"
  $(d_recurse0 $$)
  echo "$FUNCNAME invoked recurse0 locally and my-pid is now \"${my_pid}\""
  return $?
}

d_recurse3 () {
  # weird: recurse0 receives the word "invoked" as $$
  # weird: recurse0 also receives the word "invoked" as $$
  local my_pid="pid-$$"
  echo "$FUNCNAME invoking recurse0 process sub-shell from PID ($$) from PID ($1)"
  $($prog recurse0 $$)
  echo "$FUNCNAME invoked recurse0 locally and my-pid is now \"${my_pid}\""
  return $?
}

d_recurse4 () {
  local my_pid="pid-$$"
  echo "$FUNCNAME invoking recurse0 process sub-shell from PID ($$) from PID ($1)"
  bash -c "$prog recurse0 $$"
  echo "$FUNCNAME invoked recurse0 locally and my-pid is now \"${my_pid}\""
  return $?
}

# display the options as set in the environment after options processed
d_settings0 () {
  local tag="${1:-}"
  if [[ -z "$tag" ]]; then
    set | grep -E -e '^(verbose|d_.+|_M_)=' | sed -E -e 's,^,# ,g'
  elif [[ "$tag" == "all" ]]; then
    compgen -v
  else
    declare -p "$tag"
  fi
}

## Module loading
# Optimized File Finder


# Dynamic Module Loader
# Usage: e_mod_loader <module_name>
e_mod_loader() {
  local -r mod="$1"
  local -r vpath_name="${2:-THIS_VPATH_NAME}"
  local -r marker="e_${mod}_load"

  # 1. Idempotency Check: Is it already loaded?
  if declare -F "$marker" >/dev/null; then
    return 0
  fi

  echo "# Loading module [${mod}]..." >&7

  local found_sh=()
  local found_def=()

  # 2. Search for configuration (.def)
  f_mod_find "def" "$mod" "${!vpath_name}" found_def
  for f in "${found_def[@]}"; do
    e_fs_source0 "$f"
  done

  # 3. Search for logic (.sh)
  f_mod_find "sh" "$mod" "${!vpath_name}" found_sh
  if [[ ${#found_sh[@]} -eq 0 ]]; then
    d_ERRMSG="[e_mod_loader] Module [${mod}.sh] not found in VPATH"
    return 4
  fi

  # 4. Source the logic
  for f in "${found_sh[@]}"; do
    e_fs_source0 "$f"
  done

  # 5. Final Validation: Did the file actually contain the marker?
  if ! declare -F "$marker" >/dev/null; then
    echo "# [Warning] Module [${mod}] loaded but marker [${marker}] is missing." >&7
  fi

  return 0
}

# Finds files and populates a specific array
# Usage: f_mod_find <ext> <module_name> <search_path_array> <out_array_name>
f_mod_find() {
  local ext="$1"
  local mod="$2"
  local -n _vpath="$3"
  local -n _out="$4"

  _out=() # Clear the output array

  local dir
  for dir in "${_vpath[@]}"; do
    local target="${dir}/${mod}.${ext}"
    if [[ -f "$target" ]]; then
      _out+=("$target")
    fi
  done
}

# Lock function
# Set functions as readonly
# Protect the Framework's functions by setting them to readonly
e_mod_lock() {
  local tag=${1:-'^e_'}
  local func

  # Check if 'x' is present in the current shell options ($-)
  if [[ $- == *x* ]]; then
    (( restore_x=1 ))
    set +x  # Turn it off
  fi
  # Find all functions starting with e_
  for func in $(declare -F | awk '{print $3}' | grep $tag); do
    readonly -f "$func"
  done
  # restore trace
  if (( restore_x > 0 )); then
    set -x
  fi

}

# A helper for resolve1
f_resolve_worker() {
  local -n __dest_tmp="$1"
  local -n __source_out="$2"  # NEW: Nameref for the path
  local target_func="$3"
  local target_file="$4"
  local source_path="${_M__LOADR_:-}/${target_file}.sh"

  [[ ! -f "$source_path" ]] && return 4

  local t_file
  t_file=$(mktemp /tmp/f_resolve.XXXXXX)

  if (
    set +u
    source "$source_path" >/dev/null 2>&1
    declare -f "$target_func"
  ) > "$t_file" 2>/dev/null; then

    if [[ -s "$t_file" ]]; then
      __dest_tmp="$t_file"
      __source_out="$source_path" # PASS BACK: The real path
      return 0
    fi
  fi

  [[ -f "$t_file" ]] && rm -f "$t_file"
  return 8
}

# Refined Dynamic Function Resolver
# Usage: d_resolve1 <function_name> [prog-name] [path_var_name]
d_resolve1() {
  # 1. Parameter Validation
  if [[ $# -lt 1 ]]; then
    d_ERRMSG="[${FUNCNAME[0]}] (Error 1): Missing required argument 'target_function'."
    return 1
  fi

  local x_name="$1"
  local x_file="${2:-$prog}"
  local x_path_var="${3:-}" # Optional variable name to store the origin path
  local f_tmp=""
  local f_path=""

  # 2. Memory Optimization: Skip if already in memory
  if declare -F "$x_name" >/dev/null; then
    return 0
  fi

  # 3. Environment Test
  if [[ ! -v _M__LOADR_ ]]; then
    d_ERRMSG="[${FUNCNAME[0]}] (Error 2): Bound variable failure. _M__LOADR_ is missing."
    return 2
  fi

  # 4. Invoke Worker
  # Note: f_path captures the actual source path from the worker
  f_resolve_worker f_tmp f_path "$x_name" "$x_file"
  local ldr_exit=$?

  case $ldr_exit in
    0)
      # Bring function into main shell memory
      source "$f_tmp"
      rm -f "$f_tmp"

      # If a path variable name was provided, store the path globally
      # This allows the function to 'self-source' its origin later.
      if [[ -n "$x_path_var" ]]; then
        printf -v "$x_path_var" "%s" "$f_path"
      fi

      echo "# ${FUNCNAME[0]}: [${x_name}] successfully loaded from [$f_path]" >&7
      return 0
      ;;
    4)
      d_ERRMSG="[${FUNCNAME[0]}] (Error 4): Library file [${x_file}.sh] not found in ${_M__LOADR_}."
      return 4
      ;;
    8)
      d_ERRMSG="[${FUNCNAME[0]}] (Error 8): Extraction failed. Function [${x_name}] not in [${x_file}.sh]."
      return 8
      ;;
    *)
      d_ERRMSG="[${FUNCNAME[0]}] (Error ${ldr_exit}): Unexpected worker failure."
      return "$ldr_exit"
      ;;
  esac
}

## Snapshot variables with a specific prefix to a persistent state file
e_state_save() {
  local prefix="${1:-_D_}"
  local tmp_state=""

  # 1. Path Resolution Hierarchy:
  # 1st: Systemd-provided STATE_DIRECTORY
  # 2nd: XDG_STATE_HOME
  # 3rd: Standard ~/.local/state fallback
  local base_state="${STATE_DIRECTORY:-${XDG_STATE_HOME:-$HOME/.local/state}}"
  local state_dir="${base_state}/${prog}"
  local state_file="${state_dir}/${prog}.def"

  # 2. Directory Validation
  if [[ ! -d "$state_dir" ]]; then
    mkdir -p "$state_dir" || {
      d_ERRMSG="[${FUNCNAME[0]}] Error: Could not create persistence directory [$state_dir]"
      return 2
    }
  fi

  # 3. Secure Payload Creation
  # Using your nameref wrapper to track the temp file in TFILES
  e_tpush1 tmp_state

  {
    echo "# State Snapshot: $(date +%FT%T)"
    echo "# Program: $prog | PID: $$"
    local var
    # compgen -v lists all variables matching the prefix
    for var in $(compgen -v "$prefix"); do
      declare -p "$var"
    done
  } > "$tmp_state"

  # 4. Atomic Commit with GNU Versioning
  # --backup=numbered ensures we never lose the previous successful state
  if [[ -s "$tmp_state" ]]; then
    if cp --force --backup=numbered "$tmp_state" "$state_file" 2>/dev/null; then
      echo "# Persistence: State archived to $state_file" >&7
    else
      # Fallback for non-GNU cp
      cp -f "$tmp_state" "$state_file"
      echo "# Persistence: State saved (Backups unavailable) to $state_file" >&7
    fi
  fi
}

e_state_load() {
  local base_state="${STATE_DIRECTORY:-${XDG_STATE_HOME:-$HOME/.local/state}}"
  local state_file="${base_state}/${prog}/${prog}.def"

  if [[ -f "$state_file" ]]; then
    # shellcheck source=/dev/null
    source "$state_file"
    echo "# Persistence: Variables restored from $state_file" >&7
    return 0
  fi
  return 1
}

# Core logic to format variables by prefix
# Usage: e_state_dump "_D_" > /dev/fd/7
e_state_dump() {
  local prefix="${1:-_M_}"
  local var

  echo "# State Dump: $(date +%FT%T) | Prefix: $prefix"
  # compgen -v is the fastest way to filter the environment
  for var in $(compgen -v "$prefix"); do
    declare -p "$var" 2>/dev/null | sed 's/declare -[a-z]*r[a-z]*/declare/g'
  done
}

# Define semantic aliases for the array indexes
readonly _M_P_DIR=0 _M_P_FILE=1 _M_P_EXT=2 _M_P_BASE=3 _M_P_DEPTH=4

# Extended Path Parser with Network Support
# Usage: e_path_parse "tcp://127.0.0.1:17777" my_arr
# Indexes:
#   0 = Dir/Host  1 = File/FullAddr  2 = Ext/Scheme
#   3 = Base      4 = Depth          5 = Port
e_path_parse() {
  local _path="$1"
  local -n _out_arr="$2"
  _out_arr=()

  # --- New: Scheme Detection (TCP/Socket) ---
  # Check if path contains '://'

  if [[ "$_path" == *"://"* ]]; then 
    local scheme="${_path%%://*}" 
    local address="${_path#*://}" 

    # 1. Separate path from the host/port authority
    local host_port="$address"
    local path=""
    if [[ "$address" == */* ]]; then
      host_port="${address%%/*}"
      path="/${address#*/}"
    fi

    # 2. Handle Port extraction from the host_port part
    local host="$host_port"
    local port=""
    if [[ "$host_port" == *":"* ]]; then
      host="${host_port%:*}"
      port="${host_port##*:}"
    fi

    local path_len=${#path}

    _out_arr[0]="$host"        # 0: Hostname/IP 
    _out_arr[1]="$address"     # 1: Full address (host:port/path) 
    _out_arr[2]="$scheme"      # 2: Scheme (http, tcp, socket, etc) 
    _out_arr[3]="$path"        # 3: Path after port (e.g., /transmission) 
    _out_arr[4]="$path_len"    # 4: Depth (length of the path) 
    _out_arr[5]="$port"        # 5: Port (e.g., 9091) 
    return 0
  fi

  if [[ "$_path" =~ ^([^[:space:]]+):(.*)$ ]]; then 
    local scheme="${BASH_REMATCH[1]}"
    local address="${BASH_REMATCH[2]}"

    local host=""
    local port=""
    local path=""

    # Check if it has an authority section (starts with //)
    if [[ "$address" == //* ]]; then
        local remainder="${address#//}"
        local host_port="$remainder"
        
        # Separate path from host/port if a slash exists
        if [[ "$remainder" == */* ]]; then
            host_port="${remainder%%/*}"
            path="/${remainder#*/}"
        fi

        # Extract Port from host_port
        host="$host_port"
        if [[ "$host_port" == *":"* ]]; then
            host="${host_port%:*}"
            port="${host_port##*:}"
        fi
    else
        # No // authority (e.g., socket:/var/run/docker.sock)
        path="$address"
    fi

    local path_len=${#path}

    _out_arr[0]="$host"        # 0: Hostname/IP (empty if no host)
    _out_arr[1]="$address"     # 1: Address part after colon
    _out_arr[2]="$scheme"      # 2: Scheme (http, socket, mailto, etc.)
    _out_arr[3]="$path"        # 3: Path part
    _out_arr[4]="$path_len"    # 4: Depth (length of the path)
    _out_arr[5]="$port"        # 5: Port (empty if no port)
    return 0
fi

  # --- Original Filesystem Logic ---

  # 1. Directory (dirname)
  local d="${_path%/*}"
  [[ "$d" == "$_path" ]] && d="."
  _out_arr[0]="$d"

  # 2. Full Filename (basename)
  local f="${_path##*/}"
  _out_arr[1]="$f"

  # 3. Extension (extname)
  local e="${f##*.}"
  [[ "$e" == "$f" ]] && e=""
  _out_arr[2]="$e"

  # 4. Filebase (Name without extension)
  _out_arr[3]="${f%.*}"

  # 5. Depth
  if [[ "$d" == "." ]]; then
    _out_arr[4]=0
  elif [[ "$d" == "/" ]]; then
    _out_arr[4]=1
  else
    local slashes="${d//[^\/]}"
    _out_arr[4]="${#slashes}"
  fi

  _out_arr[5]="" # 5: No Port for files
}

## File System: Source with Validation
# $1: Full path to the file
e_fs_source0() {
  local __file="$1"

  # 1. Existence check
  [[ ! -f "$__file" ]] && e_err_fatal0 "e_fs_source0: File not found [$__file]"

  # 2. Syntax Pre-flight (using bash -n)
  # This catches syntax errors without executing the file.
  local __err_out
  if ! __err_out=$(bash -n "$__file" 2>&1); then
    e_err_report0 "Syntax error in [$__file]"
    {
      echo "------------------------------------------------"
      echo "FILE: $__file"
      echo "ERR : $__err_out"
      echo "------------------------------------------------"
      echo "$d_ERRMSG"
    } >&2
    exit 3
  fi

  # 3. Execution (The actual source)
  # We wrap this in a subshell-like check if you want to catch
  # runtime errors during the source itself.
  if [[ "${VERBOSE:-}" == "yes" ]]; then
    echo "  [load] $__file" >&7
  fi

  source "$__file"
}

# e_fsstk_reset (stack_ptr, register_ptr, sentinel)
# Truncates all writable files in register and repopulates the stack with them.
## File stack - reset
# $1: Pointer to the Stack (e.g., m_stk1 or m_fsstk)
# $2: Pointer to the File Register (e.g., m_fs or _example2_f)
# $3: The Sentinel value for the stack
# Non-writable files are not zeroed
# Only zero-length files are pushed
# Note: so one can mark a zero-length file as read-only, eg. a lock file.
e_fsstk_reset() {
  local __stk_ptr="$1"
  local __reg_ptr="$2"
  local __sntl="$3"
  local __stk_name="" __reg_name=""
  e_ptr_resolve __stk_name "$__stk_ptr"
  e_ptr_resolve __reg_name "$__reg_ptr"

  unset "$__stk_name"
  declare -ag "$__stk_name"
  eval "$__stk_name=('')"

  local -n __files_ref="$__reg_name"
  for __f_path in "${__files_ref[@]}"; do
    if [[ -f "$__f_path" && -w "$__f_path" ]]; then
      : > "$__f_path"
      [[ ! -s "$__f_path" ]] && e_stk_push0 "$__stk_name" "$__f_path" "$__sntl"
    fi
  done
}

## Running commands in their own environment
# There's been a problem that calling methods directly (using their d_path)
# usually means they use the global values of d_file and d_dir. These have to unset
# then set to new values.
# To avoid this e_env is provided. It creates a namespace environment and populates it
# with empty settings for d_file and the others in the namespace.

# --- Global Configuration ---
# All supported variable suffixes for the namespaces.
# Added 'output' to the list to support the -O flag.

# --- Namespace Initialization ---
# Ensures global storage exists for a namespace and initializes to safe defaults.
# Usage: e_env_init <namespace> [use_defaults_flag]
e_env_init() {
  local ns=$1
  local _use_default="${2:-}"

  for var in "${_M__VARS_[@]}"; do
    local gvar="_${ns}_${var}"
    if [[ ! -v "$gvar" ]]; then
      declare -ag "$gvar"

      local default_value=""

      # Determine default value only if explicitly requested
      if [[ -n "${_use_default:-}" ]]; then
        local d_val_name="d_${var}"

        # Handle specific defaults for numbers or special strings
        case "$var" in
          count)    default_value=${d_count:-"-1"} ;;
          user)     default_value=${d_user:-${USER:-${LOGNAME:-$(id -un)}}} ;;
          *)        default_value="${!d_val_name:-""}" ;;
        esac
      fi

      # Use printf -v to assign safely in a set -u environment
      printf -v "${gvar}[0]" "%s" "$default_value"
    fi
  done
}

# Settings Capture (Test Function)
d_settings1() {
  # $1: Nameref to the associative array
  local -n _target_array="$1"
  shift || true

  # Using nameref to global configuration list
  local -n v_list="_M__VARS_"

  for var in "${v_list[@]}"; do
    local d_var_name="d_${var}"

    if [[ -v "$d_var_name" ]]; then
      _target_array["$d_var_name"]="${!d_var_name}"
    else
      _target_array["$d_var_name"]=""
    fi
  done
  echo "# $FUNCNAME extra-args : \"$@\""
}

# --- Namespace Export ---
# Reverses initialization: Takes values FROM the namespace and EXPORTS them
# to the environment as d_<var> variables.
# Usage: e_env_export <namespace>
e_env_export() {
  local ns=$1

  # Validation
  if [[ ! -v "_${ns}_dir" ]]; then
    echo "Error: Namespace '$ns' not initialized."
    return 1
  fi

  # Reference the global list via nameref for internal use
  local -n v_list="_M__VARS_"

  for var in "${v_list[@]}"; do
    local gvar="_${ns}_${var}[0]"
    local env_var="d_${var}"

    # Export the value from the namespace array to the d_ environment variable
    export "$env_var"="${!gvar}"
  done
}

# --- Namespace Debug/Show Helper ---
e_env_show () {
  local ns=$1
  for var in "${_M__VARS_[@]}"; do
    local gvar="_${ns}_${var}"
    if [[ ! -v "$gvar" ]]; then
      echo "# $FUNCNAME not found : $gvar"
      continue
    fi
    echo "# $FUNCNAME found : $gvar : value : ${!gvar}"
  done
}

# --- The Context Provider (Execution Wrapper) ---
# Usage: e_env [options] <namespace> <function_name> <output_array_name> [--] [args]
# Utilizes util-linux getopt for robust parsing and long-option support.
e_env() {
  # 1. Setup getopt
  # -o is for options, -O is for output
  local SHORT="d:f:c:P:l:u:e:o:O:p:r:a:s:"
  local LONG="dir:,file:,count:,pass:,log:,user:,exec:,options:,output:,port:,ref:,aflag:,service:"

  local PARSED
  PARSED=$(getopt --options=$SHORT --longoptions=$LONG --name "e_env" -- "$@")
  [[ $? -ne 0 ]] && return 1

  # Normalize positional parameters
  eval set -- "$PARSED"

  # Temporary storage for options parsed from CLI
  local opt_dir="" opt_file="" opt_count="" opt_pass="" opt_log=""
  local opt_user="" opt_exec="" opt_opts="" opt_out="" opt_port=""
  local opt_ref="" opt_aflag="" opt_service=""

  # 2. Process Options
  while true; do
    case "$1" in
      -d|--dir)     opt_dir="$2";     shift 2 ;;
      -f|--file)    opt_file="$2";    shift 2 ;;
      -c|--count)   opt_count="$2";   shift 2 ;;
      -P|--pass)    opt_pass="$2";    shift 2 ;;
      -l|--log)     opt_log="$2";     shift 2 ;;
      -u|--user)    opt_user="$2";    shift 2 ;;
      -e|--exec)    opt_exec="$2";    shift 2 ;;
      -o|--options) opt_opts="$2";    shift 2 ;;
      -O|--output)  opt_out="$2";     shift 2 ;; # Handle the new -O flag
      -p|--port)    opt_port="$2";    shift 2 ;;
      -r|--ref)     opt_ref="$2";     shift 2 ;;
      -a|--aflag)   opt_aflag="$2";   shift 2 ;;
      -s|--service) opt_service="$2"; shift 2 ;;
      --)           shift; break ;;
      *)            break ;;
    esac
  done

  # 3. Extract Identifiers
  local ns="$1"
  local func="$2"
  local out_ref="$3"
  shift 3 || { echo "Error: Missing namespace, func, or out_ref"; return 1; }

  # 4. Namespace Validation
  if [[ ! -v "_${ns}_dir" ]]; then
    echo "Error: Namespace '$ns' not initialized. Call e_env_init '$ns' first."
    return 1
  fi

  # 5. Create local namerefs and 6. Update Sticky State
  for var in "${_M__VARS_[@]}"; do
    local gvar="_${ns}_${var}[0]"
    local -n n_ref="$gvar"

    case "$var" in
      dir)      [[ -n "$opt_dir" ]]     && n_ref="$opt_dir" ;;
      file)     [[ -n "$opt_file" ]]    && n_ref="$opt_file" ;;
      count)    [[ -n "$opt_count" ]]   && n_ref="$opt_count" ;;
      password) [[ -n "$opt_pass" ]]    && n_ref="$opt_pass" ;;
      log)      [[ -n "$opt_log" ]]     && n_ref="$opt_log" ;;
      user)     [[ -n "$opt_user" ]]    && n_ref="$opt_user" ;;
      exec)     [[ -n "$opt_exec" ]]    && n_ref="$opt_exec" ;;
      options)  [[ -n "$opt_opts" ]]    && n_ref="$opt_opts" ;;
      output)   [[ -n "$opt_out" ]]     && n_ref="$opt_out" ;;
      port)     [[ -n "$opt_port" ]]    && n_ref="$opt_port" ;;
      ref)      [[ -n "$opt_ref" ]]     && n_ref="$opt_ref" ;;
      aflag)    [[ -n "$opt_aflag" ]]   && n_ref="$opt_aflag" ;;
      service)  [[ -n "$opt_service" ]] && n_ref="$opt_service" ;;
    esac

    # 7. Injection: Create local d_<var> for the target function
    printf -v "d_${var}" "%s" "$n_ref"
  done

  # 8. Exec Target Function
  "$func" "$out_ref" "$@"
}

