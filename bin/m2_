## Options parameters

: ${d_helpflag:=""}             # this is the flag that is set in options there is a d_help function
: ${d_aflag:=""}

# These are the default empty values and are set in the environment ready for set -o nounset
: ${d_password:=""}
: ${d_log:=""}                  # a logfile to use in code
: ${d_output:=""}               # a file or a device
: ${d_port:=""}                 # a number
: ${d_ref:=""}                  # a file

# These need default values for post-processing
: ${d_user:=$USER}
: ${d_user:=$LOGNAME}
